# Aula 7 - Funções e Parâmetros
guarda funções específicas para usar outras vezes sem ter que repetir o código várias vezes

def nome_1(parametros):
  codigo
return o que deseja


*   não é obrigatório ter parâmetros
*   para chamar a função, precisa repetir o nome()
*   Cada função deve cumprir um único objetivo
*   As variáveis que define dentro de uma função, só existem naquela função def
*   para sair da função, tem que usar o return
*   o return sempre interrompe a função

lista_precos = [1500, 1000, 800, 2000]

def calcular_imposto(lista_valores):
  imposto_total = 0
  for preco in lista_valores:
    if preco > 1000:
      taxa = 0.15
    else:
      taxa = 0.1
    imposto = preco * taxa
    imposto_total = imposto_total + imposto

  return imposto_total

imposto_lista1 = calcular_imposto(lista_precos)
print(imposto_lista1)

lista2 = [500, 4000, 3200, 2600, 1000]
imposto_lista2 = calcular_imposto(lista2)
print(imposto_lista2)
